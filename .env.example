# Required for diarization. Get a token at https://huggingface.co/settings/tokens
# and accept the model terms at:
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# Whisper model size. On CPU, "medium" is a practical default.
# large-v3 gives the best accuracy but is noticeably slower per request.
WHISPER_MODEL=medium

# int8 is the recommended CPU compute type (fast, minimal accuracy loss).
COMPUTE_TYPE=int8
