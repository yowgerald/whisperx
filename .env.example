# Required for diarization. Get a token at https://huggingface.co/settings/tokens
# and accept the model terms at:
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# Whisper model size. "medium" is a good default; "large-v3" for best accuracy.
WHISPER_MODEL=medium

# Compute type — auto-set from DEVICE but overrideable:
#   GPU (CUDA): float16 (default) or float32
#   CPU:        int8   (default) or float32
COMPUTE_TYPE=
